# Imagem Tudo-em-Um para Nuvem / PaaS (Render, Railway, Fly.io, Cloud Run, etc.)
# Sobe 3 nós BEAM conectados em cluster + Balanceador Nginx + Painel de Métricas
# em um único container, expondo tudo na porta $PORT (padrão 4000):
#   - /         -> Chat Distribuído
#   - /painel/  -> Painel de Métricas e Gerador de Carga Ao Vivo (Pessoa 04)
#   - /metrics  -> JSON de telemetria distribuída BEAM
#
# Build e execução local em container único:
#   docker build -f Dockerfile.apresentacao -t chat-sd-nuvem .
#   docker run --rm -p 4000:4000 -p 4040:4040 chat-sd-nuvem

FROM node:22-slim AS node_runtime

FROM elixir:1.20.5-otp-27-slim

ENV MIX_ENV=prod
ENV PORT=4000
ENV PANEL_PORT=4040
ENV NOS=3
WORKDIR /app

COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nginx curl \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
COPY config ./config
RUN mix deps.get --only prod --check-locked && mix deps.compile

COPY lib ./lib
COPY priv ./priv
COPY scripts ./scripts
COPY iniciar-apresentacao.sh ./iniciar-apresentacao.sh
COPY .formatter.exs ./
RUN chmod +x ./iniciar-apresentacao.sh && mix compile --warnings-as-errors

EXPOSE 4000 4040
CMD ["sh", "./iniciar-apresentacao.sh", "container"]
